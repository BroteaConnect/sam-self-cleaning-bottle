---
import FeatureCard from '../../components/FeatureCard.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { alternates, dirOf, localePath, localePaths, stripLocale, t } from '../../lib/i18n';

// One file, every language: / (default locale) and /<code>/ for the rest.
export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const i18nPath = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
const PROJECT_NAME = 'Sam Self Cleaning Bottle';
const PROJECT_SLUG = 'sam-self-cleaning-bottle';
// Endpoint that receives requirement submissions (Brotea bot/orchestrator).
import '../../styles/theme.css';
// `||`, never `??`: the Dockerfile ARG default is an empty string, which is
// not nullish, so `??` would ship a dead form again.
const ENDPOINT = import.meta.env.PUBLIC_REQUIREMENTS_ENDPOINT?.trim() || 'https://api.brotea.dev/requirements';
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PROJECT_NAME}</title>
    <meta name="description" content={t(locale, 'meta.description')} />
    {alternates(i18nPath).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(locale, i18nPath))} />
  </head>
  <body>
    <header class="lang-bar"><LanguageSwitcher locale={locale} /></header>
    <main>
      <section class="hero">
        <h1>{t(locale, 'hero.title')}</h1>
        <p class="tagline">{t(locale, 'hero.tagline')}</p>
        <p class="sub">{t(locale, 'hero.sub')}</p>
        <a class="button" href="#requirements-form">{t(locale, 'hero.cta')}</a>
      </section>

      <section class="features" aria-labelledby="features-title">
        <h2 id="features-title">{t(locale, 'features.title')}</h2>
        <div class="feature-grid">
          {['1', '2', '3', '4'].map((n) => (
            <FeatureCard title={t(locale, `features.${n}.title`)} body={t(locale, `features.${n}.body`)} />
          ))}
        </div>
      </section>

      <section class="how" aria-labelledby="how-title">
        <h2 id="how-title">{t(locale, 'how.title')}</h2>
        <ol>
          {['step1', 'step2', 'step3'].map((step) => (
            <li>{t(locale, `how.${step}`)}</li>
          ))}
        </ol>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">{t(locale, 'faq.title')}</h2>
        {['1', '2', '3', '4'].map((n) => (
          <details>
            <summary>{t(locale, `faq.${n}.q`)}</summary>
            <p>{t(locale, `faq.${n}.a`)}</p>
          </details>
        ))}
      </section>

      <section class="cta" aria-labelledby="cta-title">
        <h2 id="cta-title">{t(locale, 'cta.title')}</h2>
        <p>{t(locale, 'cta.sub')}</p>
        <a class="button" href="#requirements-form">{t(locale, 'hero.cta')}</a>
      </section>

      <section class="form-card">
        <h2>{t(locale, 'form.title')}</h2>
        <p>{t(locale, 'form.subtitle')}</p>
        <form
          id="requirements-form"
          data-endpoint={ENDPOINT}
          data-project={PROJECT_SLUG}
          data-msg-disabled={t(locale, 'form.disabled')}
          data-msg-sending={t(locale, 'form.sending')}
          data-msg-thanks={t(locale, 'form.thanks')}
          data-msg-error={t(locale, 'form.error')}
        >
          <label>
            {t(locale, 'form.name')}
            <input type="text" name="name" required maxlength="120" />
          </label>
          <label>
            {t(locale, 'form.email')}
            <input type="email" name="email" required maxlength="200" />
          </label>
          <label>
            {t(locale, 'form.message')}
            <textarea name="content" required rows="5" maxlength="4000"></textarea>
          </label>
          <button type="submit">{t(locale, 'form.submit')}</button>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <script>
      // tipado explícito: getElementById devuelve HTMLElement, y sin esto
      // `form.reset()` y `new FormData(form)` no compilan (astro check)
      const form = document.getElementById('requirements-form') as HTMLFormElement;
      const status = document.getElementById('form-status');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.textContent = form.dataset.msgDisabled;
          return;
        }
        const data = Object.fromEntries(new FormData(form));
        status.textContent = form.dataset.msgSending;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project: form.dataset.project,
              source: 'landing_form',
              submitted_by: `${data.name} <${data.email}>`,
              content: data.content,
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = form.dataset.msgThanks;
        } catch {
          status.textContent = form.dataset.msgError;
        }
      });
    </script>

    <style>
      .lang-bar { max-width: var(--container); margin: 0 auto;
                  padding: var(--space-4) var(--space-4) 0; display: flex; justify-content: flex-end; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); color: var(--text); background: var(--bg); }
      main { max-width: var(--container); margin: 0 auto; padding: 4rem var(--space-4); }
      .hero h1 { font-family: var(--font-display); font-size: 2.5rem; margin: 0 0 .5rem; }
      .hero .tagline { font-size: 1.15rem; color: var(--accent); font-weight: 600; margin: 0 0 var(--space-3); }
      .hero .sub { font-size: 1.05rem; color: var(--muted); margin: 0 0 var(--space-5); }
      .button { display: inline-block; padding: .7rem 1.6rem; border-radius: var(--radius); background: var(--primary); color: var(--primary-contrast); font-weight: 600; text-decoration: none; }
      .button:hover { filter: brightness(0.92); }
      section h2 { font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 var(--space-4); }
      .features, .how, .faq, .cta { margin-top: var(--space-6); }
      .feature-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .how ol { margin: 0; padding-left: var(--space-5); }
      .how li { margin-bottom: var(--space-3); }
      .how li::marker { color: var(--primary); font-weight: 700; }
      .faq details { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-3); }
      .faq summary { font-weight: 600; cursor: pointer; }
      .faq details p { margin: var(--space-3) 0 0; color: var(--muted); }
      .cta { text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: var(--space-6) var(--space-5); }
      .cta p { color: var(--muted); margin: 0 0 var(--space-5); }
      .form-card { margin-top: var(--space-6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: var(--space-5); }
      label { display: block; margin-bottom: var(--space-4); font-weight: 600; }
      input, textarea { display: block; width: 100%; margin-top: .35rem; padding: .6rem; border: 1px solid var(--border); border-radius: var(--radius); font: inherit; background: var(--bg); color: var(--text); }
      button { padding: .7rem 1.6rem; border: 0; border-radius: var(--radius); background: var(--primary); color: var(--primary-contrast); font: inherit; font-weight: 600; cursor: pointer; }
      button:hover { filter: brightness(0.92); }
      #form-status { min-height: 1.2em; color: var(--muted); }
    </style>
  </body>
</html>
