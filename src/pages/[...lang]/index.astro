---
const PROJECT_NAME = '__PROJECT_NAME__';
const PROJECT_SLUG = '__PROJECT_SLUG__';
import '../../styles/theme.css';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { alternates, dirOf, has, localeOf, localePath, localePaths, series, stripLocale, t, unknownLocale } from '../../lib/i18n';

// One file, every language: getStaticPaths generates / and /<code>/ for each
// locale in src/locales/config.json.
export const getStaticPaths = localePaths;
if (unknownLocale(Astro)) return new Response(null, { status: 404 });
const locale = localeOf(Astro);

// Endpoint that receives requirement submissions (Brotea bot/orchestrator).
// `||`, never `??`: the Dockerfile ARG default is an empty string, which is
// not nullish, so `??` would ship a dead form again.
const ENDPOINT = import.meta.env.PUBLIC_REQUIREMENTS_ENDPOINT?.trim() || 'https://api.brotea.dev/requirements';
// The page is built out of the copy that EXISTS. A section with no dictionary
// entries is not an empty section with a heading and nothing under it — it is
// not there at all. That is what makes one brick enough for a one-screen
// launch page and for a full product landing: the difference between them is
// `src/locales/*.json`, which is data the copy editor already owns.
const features = series('features.{n}.title');
const steps = series('how.step{n}');
const faqs = series('faq.{n}.q');
const path = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PROJECT_NAME}</title>
    <meta name="description" content={t(locale, 'hero.tagline')} />
    {alternates(path).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath('es', path))} />
  </head>
  <body>
    <header><LanguageSwitcher locale={locale} /></header>
    <main>
      <section class="hero">
        <h1>{has('hero.title') ? t(locale, 'hero.title') : PROJECT_NAME}</h1>
        <p class="tagline">{t(locale, 'hero.tagline')}</p>
        {has('hero.sub') && <p class="sub">{t(locale, 'hero.sub')}</p>}
        {has('hero.cta') && <a class="button" href="#requirements-form">{t(locale, 'hero.cta')}</a>}
      </section>

      {features.length > 0 && (
        <section class="features" aria-labelledby="features-title">
          <h2 id="features-title">{t(locale, 'features.title')}</h2>
          <div class="feature-grid">
            {features.map((n) => (
              <article class="feature-card">
                <h3>{t(locale, `features.${n}.title`)}</h3>
                <p>{t(locale, `features.${n}.body`)}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {steps.length > 0 && (
        <section class="how" aria-labelledby="how-title">
          <h2 id="how-title">{t(locale, 'how.title')}</h2>
          <ol>{steps.map((n) => <li>{t(locale, `how.step${n}`)}</li>)}</ol>
        </section>
      )}

      {faqs.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">{t(locale, 'faq.title')}</h2>
          {faqs.map((n) => (
            <details>
              <summary>{t(locale, `faq.${n}.q`)}</summary>
              <p>{t(locale, `faq.${n}.a`)}</p>
            </details>
          ))}
        </section>
      )}

      {has('cta.title') && (
        <section class="cta" aria-labelledby="cta-title">
          <h2 id="cta-title">{t(locale, 'cta.title')}</h2>
          {has('cta.sub') && <p>{t(locale, 'cta.sub')}</p>}
          {has('hero.cta') && <a class="button" href="#requirements-form">{t(locale, 'hero.cta')}</a>}
        </section>
      )}

      <section class="form-card">
        <h2>{t(locale, 'form.title')}</h2>
        <p>{t(locale, 'form.subtitle')}</p>
        <!-- The client script is not bundled per locale, so its messages travel
             as data-* attributes rendered server-side in the right language. -->
        <form
          id="requirements-form"
          data-endpoint={ENDPOINT}
          data-project={PROJECT_SLUG}
          data-msg-disabled={t(locale, 'form.disabled')}
          data-msg-sending={t(locale, 'form.sending')}
          data-msg-thanks={t(locale, 'form.thanks')}
          data-msg-error={t(locale, 'form.error')}
        >
          <label>
            {t(locale, 'form.name')}
            <input type="text" name="name" required maxlength="120" />
          </label>
          <label>
            {t(locale, 'form.email')}
            <input type="email" name="email" required maxlength="200" />
          </label>
          <label>
            {t(locale, 'form.message')}
            <textarea name="content" required rows="5" maxlength="4000"></textarea>
          </label>
          <button type="submit">{t(locale, 'form.submit')}</button>
          <p id="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <script>
      // explicit typing: getElementById returns HTMLElement, and without this
      // `form.reset()` and `new FormData(form)` do not compile (astro check)
      const form = document.getElementById('requirements-form') as HTMLFormElement;
      const status = document.getElementById('form-status');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.textContent = form.dataset.msgDisabled;
          return;
        }
        const data = Object.fromEntries(new FormData(form));
        status.textContent = form.dataset.msgSending;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project: form.dataset.project,
              source: 'landing_form',
              submitted_by: `${data.name} <${data.email}>`,
              content: data.content,
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = form.dataset.msgThanks;
        } catch {
          status.textContent = form.dataset.msgError;
        }
      });
    </script>

    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); color: var(--text); background: var(--bg); }
      header { max-width: var(--container); margin: 0 auto; padding: var(--space-4) var(--space-4) 0; display: flex; justify-content: flex-end; }
      main { max-width: var(--container); margin: 0 auto; padding: 2rem var(--space-4) 4rem; }
      .hero h1 { font-family: var(--font-display); font-size: 2.5rem; margin: 0 0 .5rem; }
      .hero p { font-size: 1.15rem; color: var(--muted); }
      .form-card { margin-top: var(--space-6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: var(--space-5); }
      label { display: block; margin-bottom: var(--space-4); font-weight: 600; }
      input, textarea { display: block; width: 100%; margin-top: .35rem; padding: .6rem; border: 1px solid var(--border); border-radius: var(--radius); font: inherit; background: var(--bg); color: var(--text); }
      button { padding: .7rem 1.6rem; border: 0; border-radius: var(--radius); background: var(--primary); color: var(--primary-contrast); font: inherit; font-weight: 600; cursor: pointer; }
      button:hover { filter: brightness(0.92); }
      #form-status { min-height: 1.2em; color: var(--muted); }

      /* Sections that only exist when there is copy for them. Tokens only —
         a colour written here is a colour the theme cannot change. */
      .hero .tagline { font-size: 1.15rem; color: var(--muted); }
      .hero .sub { color: var(--muted); max-width: 60ch; }
      .button { display: inline-block; margin-top: var(--space-4); padding: .7rem 1.6rem; border-radius: var(--radius); background: var(--primary); color: var(--primary-contrast); font-weight: 600; text-decoration: none; }
      .button:hover { filter: brightness(0.92); }
      section + section { margin-top: var(--space-6); }
      h2 { font-family: var(--font-display); font-size: 1.75rem; }
      .feature-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
      .feature-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); }
      .feature-card h3 { margin-top: 0; font-family: var(--font-display); }
      .feature-card p, .how li, .faq p { color: var(--muted); }
      .how ol { padding-left: 1.25rem; display: grid; gap: var(--space-4); }
      .faq details { border-bottom: 1px solid var(--border); padding: var(--space-4) 0; }
      .faq summary { font-weight: 600; cursor: pointer; }
      .cta { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); text-align: center; }
    </style>
  </body>
</html>
